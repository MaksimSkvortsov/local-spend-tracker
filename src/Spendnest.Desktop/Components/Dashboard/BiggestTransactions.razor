<div class="dashboard-widget-heading">Top 5 @WindowLabel</div>

<DataTable>
    <HeaderContent>
        <tr>
            <th>Merchant</th>
            <th>Category</th>
            <th class="amount">Amount</th>
        </tr>
    </HeaderContent>
    <ChildContent>
        @foreach (var row in Rows)
        {
            <tr>
                <td>@row.Merchant</td>
                <td>
                    <span class="table-category-pill" style="@GetCategoryStyle(row.CategoryColor)">
                        @row.Category
                    </span>
                </td>
                <td class="amount">@row.Amount.ToString("C")</td>
            </tr>
        }
    </ChildContent>
</DataTable>

@code {
    [Parameter]
    public IReadOnlyList<BiggestTransactionRow> Rows { get; set; } = [];

    [Parameter]
    public string WindowLabel { get; set; } = string.Empty;

    private static string GetCategoryStyle(string categoryColor)
    {
        return $"--category-color: {categoryColor}";
    }
}
