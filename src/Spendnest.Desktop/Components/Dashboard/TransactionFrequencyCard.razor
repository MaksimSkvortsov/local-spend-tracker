<Card Class="dashboard-card frequency-card" Title="Transaction Frequency" Subtitle="@WindowLabel">
    <div class="frequency-list">
        @foreach (var row in FrequencyRows)
        {
            <div class="frequency-row">
                <p>@row.Label</p>
                <div class="@row.GridClass" style="@row.GridStyle" aria-label="@($"{row.Label} transaction frequency")">
                    @foreach (var cell in row.Cells)
                    {
                        <span class="@GetFrequencyCellClass(cell.Count)"
                              title="@GetFrequencyCellTitle(cell)">
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="frequency-legend" aria-hidden="true">
        <span>Less</span>
        <div>
            <i class="frequency-cell empty"></i>
            <i class="frequency-cell medium"></i>
            <i class="frequency-cell high"></i>
        </div>
        <span>More</span>
    </div>
</Card>

@code {
    [Parameter]
    public IReadOnlyList<Transaction> Transactions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<CardAccount> Cards { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<Guid, string> CardNames { get; set; } = new Dictionary<Guid, string>();

    [Parameter]
    public ReportMode Mode { get; set; }

    [Parameter]
    public int Year { get; set; }

    [Parameter]
    public int Month { get; set; }

    [Parameter]
    public string WindowLabel { get; set; } = string.Empty;

    private IReadOnlyList<FrequencyRow> FrequencyRows
    {
        get
        {
            var frequencyWindow = BuildFrequencyWindow();
            if (frequencyWindow is null)
            {
                return [];
            }

            var (startDate, endDate) = frequencyWindow.Value;
            var dates = BuildFrequencyDates(startDate, endDate).ToArray();
            var columnCount = Mode == ReportMode.Month
                ? Math.Max(1, dates.Count(date => date is not null))
                : Math.Max(1, dates.Length / 7);
            var rowCount = Mode == ReportMode.Month
                ? 1
                : 7;
            var transactionsByCard = Transactions
                .GroupBy(transaction => transaction.CardAccountId)
                .ToDictionary(
                    group => group.Key,
                    group => group
                        .GroupBy(transaction => transaction.PostedDate)
                        .ToDictionary(dateGroup => dateGroup.Key, dateGroup => dateGroup.Count()));

            var cardIds = Cards
                .Select(card => card.Id)
                .Where(cardId => transactionsByCard.ContainsKey(cardId))
                .Concat(transactionsByCard.Keys.Where(cardId => !CardNames.ContainsKey(cardId)))
                .Distinct()
                .ToArray();

            return cardIds
                .Select(cardId =>
                {
                    transactionsByCard.TryGetValue(cardId, out var countsByDate);
                    countsByDate ??= new Dictionary<DateOnly, int>();

                    return new FrequencyRow(
                        CardNames.GetValueOrDefault(cardId, "Unknown Card"),
                        Mode == ReportMode.Month
                            ? "frequency-cells month"
                            : "frequency-cells year",
                        $"--frequency-columns: {columnCount}; --frequency-rows: {rowCount}",
                        dates
                            .Select(date => date is null
                                ? new FrequencyCell(null, 0)
                                : new FrequencyCell(date, countsByDate.GetValueOrDefault(date.Value)))
                            .ToArray());
                })
                .ToArray();
        }
    }

    private (DateOnly StartDate, DateOnly EndDate)? BuildFrequencyWindow()
    {
        if (Mode == ReportMode.All)
        {
            var dates = Transactions
                .Select(transaction => transaction.PostedDate)
                .ToArray();

            return dates.Length == 0
                ? null
                : (dates.Min(), dates.Max());
        }

        if (Year == 0)
        {
            return null;
        }

        if (Mode == ReportMode.Year)
        {
            return (new DateOnly(Year, 1, 1), new DateOnly(Year, 12, 31));
        }

        if (Month is < 1 or > 12)
        {
            return null;
        }

        var monthStart = new DateOnly(Year, Month, 1);
        return (monthStart, monthStart.AddMonths(1).AddDays(-1));
    }

    private IEnumerable<DateOnly?> BuildFrequencyDates(DateOnly startDate, DateOnly endDate)
    {
        if (Mode == ReportMode.Month)
        {
            return EachDate(startDate, endDate).Select(date => (DateOnly?)date);
        }

        var dates = new List<DateOnly?>();
        var leadingBlanks = GetWeekRowIndex(startDate);
        dates.AddRange(Enumerable.Repeat<DateOnly?>(null, leadingBlanks));
        dates.AddRange(EachDate(startDate, endDate).Select(date => (DateOnly?)date));

        var trailingBlanks = (7 - (dates.Count % 7)) % 7;
        dates.AddRange(Enumerable.Repeat<DateOnly?>(null, trailingBlanks));

        return dates;
    }

    private static IEnumerable<DateOnly> EachDate(DateOnly startDate, DateOnly endDate)
    {
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            yield return date;
        }
    }

    private static int GetWeekRowIndex(DateOnly date)
    {
        return date.DayOfWeek == DayOfWeek.Sunday
            ? 6
            : (int)date.DayOfWeek - 1;
    }

    private static string GetFrequencyCellClass(int transactionCount)
    {
        return transactionCount switch
        {
            <= 0 => "frequency-cell empty",
            1 => "frequency-cell medium",
            _ => "frequency-cell high"
        };
    }

    private static string GetFrequencyCellTitle(FrequencyCell cell)
    {
        return cell.Date is null
            ? "Outside report window"
            : $"{cell.Date.Value:MMM d, yyyy}: {cell.Count} transactions";
    }

    private sealed record FrequencyRow(
        string Label,
        string GridClass,
        string GridStyle,
        IReadOnlyList<FrequencyCell> Cells);

    private sealed record FrequencyCell(
        DateOnly? Date,
        int Count);
}
