<DataTable HasItems="@(Rows.Count > 0)"
           EmptyMessage="No uploads in this session."
           EmptyStateClass="empty-state compact"
           TableClass="import-history-table">
    <HeaderContent>
        <tr>
            <th class="history-file-column">File Name</th>
            <th class="history-count-column">Count</th>
            <th class="history-range-column">Transaction Range</th>
            <th class="status-column">Status</th>
            <th class="date-column">Date Imported</th>
            <th class="history-actions-column" aria-label="Actions"></th>
        </tr>
    </HeaderContent>
    <ChildContent>
        @foreach (var upload in PagedRows)
        {
            <tr @key="upload.Id">
                <td class="history-file-column">
                    <span class="history-file">
                        <span class="material-symbols-outlined" aria-hidden="true">description</span>
                        <span>@upload.FileName</span>
                    </span>
                    <span class="history-imported-date">@upload.ImportedAtLocal.ToString("MMM d, yyyy")</span>
                    <span class="history-status-inline @GetImportStatusClass(upload)">@upload.StatusLabel</span>
                    @if (!string.IsNullOrWhiteSpace(upload.ErrorMessage))
                    {
                        <div class="alert error" role="alert">
                            <div>@upload.ErrorMessage</div>
                        </div>
                    }
                </td>
                <td class="data-cell history-count-column">@upload.SavedTransactionCount</td>
                <td class="history-range-column">@upload.TransactionRange</td>
                <td class="status-column"><span class="@GetImportStatusClass(upload)">@upload.StatusLabel</span></td>
                <td class="date-column">@upload.ImportedAtLocal.ToString("MMM d, yyyy")</td>
                <td class="history-actions-column">
                    <button type="button"
                            class="table-icon-button"
                            aria-label="@($"Actions for {upload.FileName}")"
                            aria-expanded="@(openActionsImportId == upload.Id)"
                            aria-controls="@($"import-actions-{upload.Id}")"
                            disabled="@IsBusy"
                            @onclick="() => ToggleActions(upload.Id)">
                        <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
                    </button>
                </td>
            </tr>
            @if (openActionsImportId == upload.Id)
            {
                <tr class="import-history-actions-row">
                    <td colspan="6">
                        <div id="@($"import-actions-{upload.Id}")" class="import-history-delete-confirmation" role="group" aria-label="@(upload.CanRetry ? "Retry or delete import" : "Confirm deleting import")">
                            @if (upload.CanRetry)
                            {
                                <span>Retry importing "@upload.FileName", or delete this failed import. No transactions were saved from it. The CSV file on your computer will stay.</span>
                            }
                            else
                            {
                                <span>Delete "@upload.FileName" and its @upload.SavedTransactionCount imported transactions? The CSV file on your computer will stay.</span>
                            }
                            <div>
                                <button type="button" class="secondary-button" disabled="@IsBusy" @onclick="CloseActions">Cancel</button>
                                @if (upload.CanRetry)
                                {
                                    <button type="button"
                                            class="primary-button"
                                            disabled="@(IsBusy || !RetryEnabled)"
                                            title="@(RetryEnabled ? null : "Cancel the selected file to retry this import.")"
                                            @onclick="() => RetryAsync(upload.Id)">Retry Import</button>
                                }
                                <button type="button" class="danger-button" disabled="@IsBusy" @onclick="() => OnDelete.InvokeAsync(upload.Id)">Delete Import</button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </ChildContent>
    <FooterContent>
        <PaginationBar ContainerClass="import-history-footer"
                       CurrentPage="@CurrentPage"
                       PageCount="@PageCount"
                       ShowingCount="@PagedRows.Count"
                       TotalCount="@Rows.Count"
                       ItemLabel="imports"
                       ShowSummary="true"
                       StrongPageLabel="true"
                       OnPrevious="OnPrevious"
                       OnNext="OnNext" />
    </FooterContent>
</DataTable>

@code {
    [Parameter]
    public IReadOnlyList<UploadHistoryItem> Rows { get; set; } = [];

    [Parameter]
    public IReadOnlyList<UploadHistoryItem> PagedRows { get; set; } = [];

    [Parameter]
    public int CurrentPage { get; set; }

    [Parameter]
    public int PageCount { get; set; }

    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRetry { get; set; }

    [Parameter]
    public bool RetryEnabled { get; set; } = true;

    [Parameter]
    public bool IsBusy { get; set; }

    private Guid? openActionsImportId;

    private async Task RetryAsync(Guid importId)
    {
        openActionsImportId = null;
        await OnRetry.InvokeAsync(importId);
    }

    private void ToggleActions(Guid importId)
    {
        openActionsImportId = openActionsImportId == importId ? null : importId;
    }

    private void CloseActions()
    {
        openActionsImportId = null;
    }

    private static string GetImportStatusClass(UploadHistoryItem upload)
    {
        if (upload.Status == StatementImportStatus.Failed)
        {
            return "import-status failed";
        }

        return upload.Status == StatementImportStatus.Pending
            ? "import-status pending"
            : "import-status complete";
    }
}
