@page "/dashboard"
@inject DashboardService DashboardService
@inject ITransactionMerchantCodeResolver MerchantCodeResolver
@inject AppDataRefreshNotifier DataRefreshNotifier
@inject DashboardPeriodState PeriodState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Dashboard - PeasantMoney</PageTitle>

@if (transactions.Count == 0)
{
    <Card Class="dashboard-empty-card">
        <DashboardEmptyState IsAiConfigured="@IsAiConfigured"
                             OnActionClick="GoToNextSetupStep" />
    </Card>
}
else
{
    <section class="app-card dashboard-metric-panel">
        <DashboardPeriodSelector Mode="@reportMode"
                                 Year="@selectedYear"
                                 Month="@selectedMonth"
                                 AvailableYears="@AvailableYears"
                                 PeriodChanged="ChangeReportPeriodAsync" />

        <div class="dashboard-metrics">
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Window</span>
                <strong>@WindowRangeLabel</strong>
            </div>
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Total Spend</span>
                <strong class="metric-primary">@totalSpending.ToString("C")</strong>
            </div>
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Transactions</span>
                <strong>@filteredTransactions.Count</strong>
            </div>
        </div>
    </section>

    <section class="dashboard-workspace-grid">
        <Card Class="spending-card" Title="Spending by Category">
            <SpendingByCategory Lines="@report.Lines"
                                CategoryColors="@categoryColorsById" />
        </Card>

        <div class="dashboard-side-stack">
            <Card Title="Top Merchants">
                <TopMerchants Transactions="@filteredTransactions"
                              MerchantCodeResolver="@MerchantCodeResolver" />
            </Card>

            <Card Title="Needs Attention">
                <NeedsAttention ReviewCount="@reviewCount" />
            </Card>
        </div>
    </section>

    <Card Title="Biggest Transactions">
        <BiggestTransactions Rows="@biggestTransactionRows"
                             WindowLabel="@ReportWindowShortLabel" />
    </Card>

    <Card Title="Transaction Frequency">
        <TransactionFrequency Transactions="@filteredTransactions"
                              Cards="@cards"
                              CardNames="@cardNamesById"
                              Mode="@reportMode"
                              Year="@selectedYear"
                              Month="@selectedMonth"
                              WindowLabel="@ReportWindowShortLabel" />
    </Card>

    <Card Title="Amount Spent per Day">
        <DailySpend Transactions="@filteredTransactions"
                    Mode="@reportMode"
                    Year="@selectedYear"
                    Month="@selectedMonth"
                    WindowLabel="@ReportWindowShortLabel" />
    </Card>
}

@code {
    private DashboardModel dashboard = DashboardModel.Empty;
    private ReportMode reportMode = ReportMode.Year;
    private int selectedYear;
    private int selectedMonth;

    private IReadOnlyList<Transaction> transactions => dashboard.Transactions;

    private IReadOnlyList<Transaction> filteredTransactions => dashboard.FilteredTransactions;

    private CategorySpendingReport report => dashboard.Report;

    private decimal totalSpending => dashboard.TotalSpending;

    private int reviewCount => dashboard.ReviewCount;

    private IReadOnlyList<CardAccount> cards => dashboard.Cards;

    private IReadOnlyDictionary<int, string> categoryColorsById => dashboard.CategoryColorsById;

    private IReadOnlyDictionary<Guid, string> cardNamesById => dashboard.CardNamesById;

    private IReadOnlyList<BiggestTransactionRow> biggestTransactionRows => dashboard.BiggestTransactionRows;

    private bool IsAiConfigured => dashboard.IsAiConfigured;

    private IReadOnlyList<int> AvailableYears => dashboard.AvailableYears;

    private string ReportWindowShortLabel => dashboard.ReportWindowShortLabel;

    private string WindowRangeLabel => dashboard.WindowRangeLabel;

    protected override async Task OnInitializedAsync()
    {
        DataRefreshNotifier.TransactionsChanged += HandleTransactionsChanged;
        await LoadDashboardDataAsync(preserveSelectedWindow: false, focusDate: null);
    }

    private async Task LoadDashboardDataAsync(bool preserveSelectedWindow, DateOnly? focusDate)
    {
        dashboard = await DashboardService.LoadAsync(
            new DashboardLoadRequest(
                preserveSelectedWindow,
                focusDate,
                reportMode,
                selectedYear,
                selectedMonth,
                PeriodState.Mode,
                PeriodState.Year,
                PeriodState.Month),
            CancellationToken.None);

        reportMode = dashboard.Mode;
        selectedYear = dashboard.Year;
        selectedMonth = dashboard.Month;
    }

    private void HandleTransactionsChanged(DateOnly? focusDate)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDashboardDataAsync(preserveSelectedWindow: true, focusDate);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DataRefreshNotifier.TransactionsChanged -= HandleTransactionsChanged;
    }

    private async Task ChangeReportPeriodAsync(ReportPeriod period)
    {
        if (reportMode == period.Mode
            && selectedYear == period.Year
            && selectedMonth == period.Month)
        {
            return;
        }

        reportMode = period.Mode;
        selectedYear = period.Year;
        selectedMonth = period.Month;
        SavePeriodState();
        await LoadDashboardDataAsync(preserveSelectedWindow: true, focusDate: null);
    }

    private void SavePeriodState()
    {
        PeriodState.Mode = reportMode.ToString();
        PeriodState.Year = selectedYear == 0 ? null : selectedYear;
        PeriodState.Month = selectedMonth == 0 ? null : selectedMonth;
    }

    private void GoToNextSetupStep()
    {
        NavigationManager.NavigateTo(IsAiConfigured ? "import" : "settings");
    }

}
