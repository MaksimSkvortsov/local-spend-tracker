@page "/dashboard"
@using Spendnest.Core.Credentials
@using Spendnest.Core.Review
@inject ITransactionRepository TransactionRepository
@inject ICategorySpendingReportService ReportService
@inject ITransactionCategoryAssignmentRepository AssignmentRepository
@inject ITransactionReviewService ReviewService
@inject ITransactionMerchantCodeResolver MerchantCodeResolver
@inject ICardAccountRepository CardAccountRepository
@inject ICategoryRepository CategoryRepository
@inject ICredentialStore CredentialStore
@inject AppDataRefreshNotifier DataRefreshNotifier
@inject DashboardPeriodState PeriodState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Dashboard - PeasantMoney</PageTitle>

@if (transactions.Count == 0)
{
    <section class="app-card dashboard-empty-card">
        <div class="dashboard-empty-content">
            <div class="dashboard-empty-icon">
                <img src="images/peasantmoney-icon.png" alt="" aria-hidden="true" />
            </div>

            <h1>Welcome to PeasantMoney</h1>
            <p>Set up private AI categorization, then import your first credit card statement to unlock local spending reports.</p>

            <div class="dashboard-empty-checklist" aria-label="Getting started checklist">
                <h2>Getting Started</h2>

                <div class="@GetChecklistItemClass(IsAiConfigured)">
                    <span class="material-symbols-outlined" aria-hidden="true">@GetChecklistIcon(IsAiConfigured)</span>
                    <span>Configure AI in Settings</span>
                </div>

                <div class="@GetChecklistItemClass(false)">
                    <span class="material-symbols-outlined" aria-hidden="true">check_box_outline_blank</span>
                    <span>Upload the first statement in Import</span>
                </div>
            </div>

            <button type="button" class="primary-button dashboard-empty-action" @onclick="GoToNextSetupStep">
                <span class="material-symbols-outlined" aria-hidden="true">@NextSetupActionIcon</span>
                @NextSetupActionLabel
            </button>
        </div>
    </section>
}
else
{
    <section class="app-card dashboard-metric-panel">
        <DashboardPeriodSelector Mode="@reportMode"
                                 Year="@selectedYear"
                                 Month="@selectedMonth"
                                 AvailableYears="@AvailableYears"
                                 PeriodChanged="ChangeReportPeriodAsync" />

        <div class="dashboard-metrics">
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Window</span>
                <strong>@WindowRangeLabel</strong>
            </div>
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Total Spend</span>
                <strong class="metric-primary">@totalSpending.ToString("C")</strong>
            </div>
            <div class="metric-divider" aria-hidden="true"></div>
            <div>
                <span>Transactions</span>
                <strong>@filteredTransactions.Count</strong>
            </div>
        </div>
    </section>

    <section class="dashboard-workspace-grid">
        <Card Class="dashboard-card spending-card" Title="Spending by Category">
            <SpendingByCategory Lines="@report.Lines"
                                CategoryColors="@categoryColorsById" />
        </Card>

        <div class="dashboard-side-stack">
            <TopMerchantsCard Transactions="@filteredTransactions"
                              MerchantCodeResolver="@MerchantCodeResolver" />

            <NeedsAttentionCard ReviewCount="@reviewCount" />
        </div>
    </section>

    <BiggestTransactionsCard Rows="@biggestTransactionRows"
                             WindowLabel="@ReportWindowShortLabel" />

    <TransactionFrequencyCard Transactions="@filteredTransactions"
                              Cards="@cards"
                              CardNames="@cardNamesById"
                              Mode="@reportMode"
                              Year="@selectedYear"
                              Month="@selectedMonth"
                              WindowLabel="@ReportWindowShortLabel" />

    <DailySpendCard Transactions="@filteredTransactions"
                    Mode="@reportMode"
                    Year="@selectedYear"
                    Month="@selectedMonth"
                    WindowLabel="@ReportWindowShortLabel" />
}

@code {
    private IReadOnlyList<Transaction> transactions = [];
    private IReadOnlyList<Transaction> filteredTransactions = [];
    private CategorySpendingReport report = new([], 0m);
    private decimal totalSpending;
    private decimal averageTransaction;
    private decimal largestCharge;
    private decimal creditTotal;
    private int reviewCount;
    private ReportMode reportMode = ReportMode.Year;
    private int selectedYear;
    private int selectedMonth;
    private IReadOnlyList<CardAccount> cards = [];
    private IReadOnlyList<BuiltInCategory> categories = [];
    private IReadOnlyDictionary<Guid, TransactionCategoryAssignment> assignmentsByTransactionId =
        new Dictionary<Guid, TransactionCategoryAssignment>();
    private IReadOnlyDictionary<int, string> categoryNamesById =
        new Dictionary<int, string>();
    private IReadOnlyDictionary<int, string> categoryColorsById =
        new Dictionary<int, string>();
    private IReadOnlyDictionary<Guid, string> cardNamesById =
        new Dictionary<Guid, string>();
    private IReadOnlyList<BiggestTransactionRow> biggestTransactionRows = [];
    private bool isAiConfigured;

    private bool IsAiConfigured => isAiConfigured;

    private string NextSetupActionLabel =>
        IsAiConfigured ? "Import Transactions" : "Configure AI";

    private string NextSetupActionIcon =>
        IsAiConfigured ? "upload_file" : "settings";

    private IReadOnlyList<int> AvailableYears =>
        transactions
            .Select(transaction => transaction.PostedDate.Year)
            .Distinct()
            .OrderByDescending(year => year)
            .ToArray();

    private string ReportWindowLabel =>
        reportMode == ReportMode.All
            ? "All time"
            : reportMode == ReportMode.Year
            ? selectedYear.ToString()
            : new DateOnly(selectedYear, selectedMonth, 1).ToString("MMMM yyyy");

    private string ReportWindowShortLabel =>
        reportMode == ReportMode.All
            ? "All time"
            : reportMode == ReportMode.Year
            ? selectedYear.ToString()
            : new DateOnly(selectedYear, selectedMonth, 1).ToString("yyyy-MM");

    private string WindowRangeLabel
    {
        get
        {
            var query = BuildQuery();
            if (query.StartDate is null || query.EndDate is null)
            {
                var firstTransactionDate = transactions
                    .Select(transaction => (DateOnly?)transaction.PostedDate)
                    .Min();
                var lastTransactionDate = transactions
                    .Select(transaction => (DateOnly?)transaction.PostedDate)
                    .Max();

                return firstTransactionDate is null || lastTransactionDate is null
                    ? string.Empty
                    : $"{firstTransactionDate:MMM d, yyyy} - {lastTransactionDate:MMM d, yyyy}";
            }

            return $"{query.StartDate:MMM d} - {query.EndDate:MMM d, yyyy}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DataRefreshNotifier.TransactionsChanged += HandleTransactionsChanged;
        await LoadSetupStateAsync();
        await LoadDashboardDataAsync(preserveSelectedWindow: false, focusDate: null);
    }

    private async Task LoadDashboardDataAsync(bool preserveSelectedWindow, DateOnly? focusDate)
    {
        var previousYear = selectedYear;
        var previousMonth = selectedMonth;
        var previousReportMode = reportMode;
        transactions = await TransactionRepository.ListAsync(CancellationToken.None);
        var fallbackDate = transactions
            .OrderByDescending(transaction => transaction.PostedDate)
            .Select(transaction => (DateOnly?)transaction.PostedDate)
            .FirstOrDefault();
        var selectedDate = focusDate ?? fallbackDate;
        if (selectedDate is null)
        {
            filteredTransactions = [];
            report = new CategorySpendingReport([], 0m);
            totalSpending = 0m;
            averageTransaction = 0m;
            largestCharge = 0m;
            creditTotal = 0m;
            biggestTransactionRows = [];
            return;
        }

        var availableYears = AvailableYears;
        reportMode = preserveSelectedWindow
            ? previousReportMode
            : ParseReportMode(PeriodState.Mode);
        selectedYear = GetSelectedYear(
            availableYears,
            preserveSelectedWindow ? previousYear : PeriodState.Year,
            selectedDate.Value.Year);
        selectedMonth = GetSelectedMonth(
            preserveSelectedWindow ? previousMonth : PeriodState.Month,
            selectedDate.Value.Month);
        cards = await CardAccountRepository.ListAsync(CancellationToken.None);
        categories = await CategoryRepository.ListAsync(CancellationToken.None);
        cardNamesById = cards.ToDictionary(card => card.Id, card => card.Name);
        categoryNamesById = categories.ToDictionary(category => category.Id, category => category.Name);
        categoryColorsById = categories.ToDictionary(category => category.Id, category => category.ColorHex);
        await ReloadAssignmentsAsync();
        await ReloadReportAsync();
    }

    private async Task LoadSetupStateAsync()
    {
        var apiKey = await CredentialStore.GetStringAsync(CredentialKeys.OpenAiApiKey, CancellationToken.None);
        isAiConfigured = !string.IsNullOrWhiteSpace(apiKey);
    }

    private void HandleTransactionsChanged(DateOnly? focusDate)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDashboardDataAsync(preserveSelectedWindow: true, focusDate);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DataRefreshNotifier.TransactionsChanged -= HandleTransactionsChanged;
    }

    private async Task ReloadReportAsync()
    {
        if (reportMode != ReportMode.All && selectedYear == 0)
        {
            return;
        }

        var query = BuildQuery();
        filteredTransactions = await TransactionRepository.ListAsync(query, CancellationToken.None);
        report = await ReportService.BuildAsync(query, CancellationToken.None);

        totalSpending = report.TotalSpending;
        averageTransaction = filteredTransactions.Count == 0 ? 0 : totalSpending / filteredTransactions.Count;
        largestCharge = filteredTransactions.Where(transaction => transaction.Amount > 0).DefaultIfEmpty().Max(transaction => transaction?.Amount ?? 0);
        creditTotal = filteredTransactions.Where(transaction => transaction.Amount < 0).Sum(transaction => transaction.Amount);
        RebuildBiggestTransactionRows();
    }

    private async Task ReloadAssignmentsAsync()
    {
        assignmentsByTransactionId = (await AssignmentRepository.ListAsync(CancellationToken.None))
            .ToDictionary(assignment => assignment.TransactionId);
        reviewCount = await ReviewService.CountNeedsReviewAsync(CancellationToken.None);
    }

    private async Task ChangeReportPeriodAsync(ReportPeriod period)
    {
        if (reportMode == period.Mode
            && selectedYear == period.Year
            && selectedMonth == period.Month)
        {
            return;
        }

        reportMode = period.Mode;
        selectedYear = period.Year;
        selectedMonth = period.Month;
        SavePeriodState();
        await ReloadReportAsync();
    }

    private void SavePeriodState()
    {
        PeriodState.Mode = reportMode.ToString();
        PeriodState.Year = selectedYear == 0 ? null : selectedYear;
        PeriodState.Month = selectedMonth == 0 ? null : selectedMonth;
    }

    private TransactionQuery BuildQuery()
    {
        if (reportMode == ReportMode.All)
        {
            return new TransactionQuery();
        }

        if (reportMode == ReportMode.Year)
        {
            return new TransactionQuery
            {
                StartDate = new DateOnly(selectedYear, 1, 1),
                EndDate = new DateOnly(selectedYear, 12, 31)
            };
        }

        var monthStart = new DateOnly(selectedYear, selectedMonth, 1);
        return new TransactionQuery
        {
            StartDate = monthStart,
            EndDate = monthStart.AddMonths(1).AddDays(-1)
        };
    }

    private void RebuildBiggestTransactionRows()
    {
        biggestTransactionRows = filteredTransactions
            .Where(transaction => transaction.Amount > 0)
            .OrderByDescending(transaction => transaction.Amount)
            .ThenByDescending(transaction => transaction.ImportedAtUtc)
            .Take(5)
            .Select(transaction =>
            {
                var categoryId = assignmentsByTransactionId.TryGetValue(transaction.Id, out var assignment)
                    ? assignment.CategoryId
                    : BuiltInCategoryIds.Other;

                return new BiggestTransactionRow(
                    transaction.OriginalDescription,
                    categoryNamesById.GetValueOrDefault(categoryId, "Other"),
                    categoryColorsById.GetValueOrDefault(categoryId, "#e5e7e2"),
                    transaction.Amount);
            })
            .ToArray();
    }

    private void GoToNextSetupStep()
    {
        NavigationManager.NavigateTo(IsAiConfigured ? "import" : "settings");
    }

    private static string GetChecklistIcon(bool isComplete)
    {
        return isComplete ? "check_box" : "check_box_outline_blank";
    }

    private static string GetChecklistItemClass(bool isComplete)
    {
        return isComplete
            ? "dashboard-empty-check complete"
            : "dashboard-empty-check";
    }

    private static ReportMode ParseReportMode(string? value)
    {
        return Enum.TryParse<ReportMode>(value, ignoreCase: true, out var mode)
            ? mode
            : ReportMode.Year;
    }

    private static int GetSelectedYear(
        IReadOnlyList<int> availableYears,
        int? preferredYear,
        int fallbackYear)
    {
        if (preferredYear is not null && availableYears.Contains(preferredYear.Value))
        {
            return preferredYear.Value;
        }

        return availableYears.Contains(fallbackYear)
            ? fallbackYear
            : availableYears.FirstOrDefault();
    }

    private static int GetSelectedMonth(
        int? preferredMonth,
        int fallbackMonth)
    {
        return preferredMonth is >= 1 and <= 12
            ? preferredMonth.Value
            : fallbackMonth;
    }

}
