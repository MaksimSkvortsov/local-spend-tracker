@page "/import"
@inject ImportFileSelectionService ImportFileSelectionService
@inject ImportPageService ImportPageService
@inject ImportWorkflowService ImportWorkflowService
@inject AppDataRefreshNotifier DataRefreshNotifier
@inject IStatementFilePicker StatementFilePicker

<PageTitle>Import - PeasantMoney</PageTitle>

<section class="import-page-header">
    <h1>Import Transactions</h1>
    <p>Upload your bank statements to reconcile your accounts and gain clarity on your spending habits. Your data is processed securely and remains private.</p>
</section>

@if (!selection.HasFile)
{
    <section class="import-workspace">
        <Card Class="import-upload-card" Title="Upload Statement">
            <ImportUploadPrompt IsBusy="@isBusy"
                                StatusMessage="@statusMessage"
                                OnPickFile="PickCsvAsync" />
        </Card>
    </section>
}

@if (selection.HasFile)
{
    <Card Class="selected-transactions-card"
          Title="Transactions in File"
          Subtitle="@($"Previewing {selection.PreviewRows.Count} transactions from {selection.SelectedFileName}")">
        <HeaderAction>
            <div class="selected-transactions-actions">
                <button class="secondary-button" @onclick="ClearSelectedFile" disabled="@isBusy">Cancel</button>
                <button class="primary-button" @onclick="ImportAsync" disabled="@(!CanImport)">
                    @(isBusy ? CurrentProgressLabel : "Confirm Import")
                </button>
            </div>
        </HeaderAction>

        <ChildContent>
            <SelectedTransactionsPreview CardDetected="@selection.CardDetected"
                                         CardName="@selection.CardName"
                                         CardNameChanged="SetCardName"
                                         SelectedExistingCardName="@selection.SelectedExistingCardName"
                                         SelectedExistingCardNameChanged="SetSelectedExistingCardName"
                                         OnExistingCardChanged="UseSelectedExistingCard"
                                         AvailableCards="@availableCards"
                                         CardSelectionMessage="@selection.CardSelectionMessage"
                                         StatusMessage="@statusMessage"
                                         ErrorMessage="@selection.ErrorMessage"
                                         IsBusy="@isBusy"
                                         Rows="@selection.PreviewRows"
                                         PagedRows="@PagedPreviewRows"
                                         CurrentPage="@selection.PreviewPage"
                                         PageCount="@PreviewPageCount"
                                         OnPrevious="PreviousPreviewPage"
                                         OnNext="NextPreviewPage" />
        </ChildContent>
    </Card>
}

<Card Class="import-history-card"
      Title="Import History"
      Subtitle="View and manage your recent statement uploads">
    <HeaderAction>
        <button type="button" class="icon-button" aria-label="Refresh import history" @onclick="RefreshImportHistoryViewAsync">
            <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
        </button>
    </HeaderAction>

    <ChildContent>
        <ImportHistory Rows="@history.Rows"
                       PagedRows="@history.PagedRows"
                       CurrentPage="@history.CurrentPage"
                       PageCount="@history.PageCount"
                       OnPrevious="PreviousUploadHistoryPage"
                       OnNext="NextUploadHistoryPage" />
    </ChildContent>
</Card>

@if (selection.Warnings.Count > 0)
{
    <Card Class="panel" Title="Warnings">
        <ImportWarnings Warnings="@selection.Warnings" />
    </Card>
}

@code {
    private const int PreviewPageSize = 5;

    private ImportSelectionDraft selection = new();
    private ImportHistoryState history = new();
    private string? statusMessage;
    private FileUploadProgress? currentProgress;
    private bool isBusy;
    private IReadOnlyList<CardAccount> availableCards = [];
    private Dictionary<Guid, CategorizationHistorySummary> categorizationSummariesByImportId = [];

    private string CurrentProgressLabel =>
        currentProgress?.Message ?? "Working...";

    private bool CanImport =>
        selection.CanImport(isBusy);

    private bool IsCategorizing =>
        selection.IsCategorizing(currentProgress);

    private PagedList<PreviewRow> PreviewPage =>
        PagedList<PreviewRow>.Create(selection.PreviewRows, selection.PreviewPage, PreviewPageSize);

    private IReadOnlyList<PreviewRow> PagedPreviewRows => PreviewPage.Items;

    private int PreviewPageCount => PreviewPage.PageCount;

    protected override async Task OnInitializedAsync()
    {
        await RefreshImportPageDataAsync();
    }

    private async Task PickCsvAsync()
    {
        selection.ErrorMessage = null;
        statusMessage = null;

        var file = await StatementFilePicker.PickCsvAsync(CancellationToken.None);

        if (file is null)
        {
            return;
        }

        selection.PrepareForSelectedFile(file);
        var preparedFile = await ImportFileSelectionService.PrepareAsync(
            file,
            CancellationToken.None);

        selection.ApplyPreparedFile(preparedFile, availableCards.Count);
    }

    private async Task ImportAsync()
    {
        if (!CanImport)
        {
            return;
        }

        isBusy = true;
        selection.ErrorMessage = null;
        statusMessage = null;
        currentProgress = FileUploadProgress.ReadingFile;
        var progress = new Progress<FileUploadProgress>(ReportProgress);

        try
        {
            var workflowResult = await ImportWorkflowService.ImportAndCategorizeAsync(
                selection.FilePath!,
                selection.EffectiveCardName,
                progress,
                CancellationToken.None);

            var importResult = workflowResult.ImportResult;
            selection.Warnings = importResult.Warnings;
            selection.PreviewCategoryNamesByTransactionId = workflowResult.PreviewCategoryNamesByTransactionId;
            selection.PreviewRows = ImportPreviewRows.FromImportResult(
                importResult,
                selection.PreviewCategoryNamesByTransactionId,
                IsCategorizing);
            categorizationSummariesByImportId[importResult.StatementImportId] =
                workflowResult.CategorizationSummary;
            await RefreshImportPageDataAsync();
            DataRefreshNotifier.NotifyTransactionsChanged(workflowResult.FocusDate);
            ClearSelectedFileState(clearMessages: true);
        }
        catch (Exception exception)
        {
            selection.ErrorMessage = exception.Message;
            await RefreshImportHistoryViewAsync();
        }
        finally
        {
            isBusy = false;
            currentProgress = null;
        }
    }

    private void ReportProgress(FileUploadProgress progress)
    {
        currentProgress = progress;
        statusMessage = FormatProgressMessage(progress);
        _ = InvokeAsync(StateHasChanged);
    }

    private static string FormatProgressMessage(FileUploadProgress progress)
    {
        if (progress.Stage == FileUploadProgressStage.CategorizingWithAi)
        {
            return progress.Message;
        }

        if (progress.Current is not null && progress.Total is > 0)
        {
            return $"{progress.Message} ({progress.Current}/{progress.Total})";
        }

        return progress.Message;
    }

    private async Task RefreshImportPageDataAsync()
    {
        var pageData = await ImportPageService.LoadAsync(
            categorizationSummariesByImportId,
            CancellationToken.None);

        availableCards = pageData.AvailableCards;
        history.ReplaceRows(pageData.UploadHistory);
    }

    private void PreviousUploadHistoryPage()
    {
        history.PreviousPage();
    }

    private void NextUploadHistoryPage()
    {
        history.NextPage();
    }

    private void PreviousPreviewPage()
    {
        selection.PreviewPage = Math.Max(1, selection.PreviewPage - 1);
    }

    private void NextPreviewPage()
    {
        selection.PreviewPage = Math.Min(PreviewPageCount, selection.PreviewPage + 1);
    }

    private void UseSelectedExistingCard()
    {
        selection.UseSelectedExistingCard();
    }

    private void SetCardName(string value)
    {
        selection.CardName = value;
    }

    private void SetSelectedExistingCardName(string value)
    {
        selection.SelectedExistingCardName = value;
    }

    private void ClearSelectedFile()
    {
        ClearSelectedFileState(clearMessages: true);
    }

    private void ClearSelectedFileState(bool clearMessages)
    {
        selection.Clear(clearMessages);
        if (clearMessages)
        {
            statusMessage = null;
        }
    }

    private async Task RefreshImportHistoryViewAsync()
    {
        await RefreshImportPageDataAsync();
    }
}
