@page "/settings"
@using System.Diagnostics
@using Spendnest.Core.Ai
@using Spendnest.Core.Credentials
@using Spendnest.Infrastructure.Categorization
@using Spendnest.Infrastructure.Persistence
@inject IAiConnectionTestService AiConnectionTestService
@inject ICredentialStore CredentialStore
@inject SpendnestDatabaseInitializer DatabaseInitializer
@inject NavigationManager NavigationManager
@inject OpenAiCategorizerOptions OpenAiOptions

<PageTitle>Settings - PeasantMoney</PageTitle>

<section class="settings-header">
    <div>
        <h1>Settings</h1>
        <p>Manage PeasantMoney workspace preferences and integrations.</p>
    </div>
</section>

<section class="settings-layout">
    <SettingsSubnav ActiveTab="@activeTab" OnTabSelected="SelectTab" />

    <div class="settings-content">
        @if (activeTab == SettingsTab.Ai)
        {
        <Card Class="settings-card"
              Title="AI Configuration"
              Subtitle="Configure your language model provider for smart transaction categorization.">
            <HeaderAction>
                <SettingsConnectionStatus IsConnected="@hasConfiguredApiKey" />
            </HeaderAction>

            <ChildContent>
                <div class="settings-form">
                <div class="settings-field">
                    <label>Provider</label>
                    <div class="provider-display" aria-label="AI provider">
                        <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                        ChatGPT
                    </div>
                    <p>Only OpenAI is supported for now.</p>
                </div>

                <div class="settings-key-section">
                    <div class="settings-field">
                        <label for="api-key">OpenAI API Key <span>*</span></label>
                        <div class="settings-key-row">
                            <div class="settings-input-wrap">
                                <span class="material-symbols-outlined" aria-hidden="true">key</span>
                                <input id="api-key"
                                       class="settings-input mono"
                                       type="@ApiKeyInputType"
                                       placeholder="@ApiKeyPlaceholder"
                                       @bind="apiKey" />
                                <button type="button" class="settings-field-button" aria-label="@ApiKeyVisibilityLabel" @onclick="ToggleApiKeyVisibility">
                                    <span class="material-symbols-outlined" aria-hidden="true">@ApiKeyVisibilityIcon</span>
                                </button>
                            </div>
                        </div>
                        <div class="settings-note">
                            <span class="material-symbols-outlined" aria-hidden="true">info</span>
                            <p>@ApiKeyHelpText Usage is billed directly by OpenAI.</p>
                        </div>
                    </div>

                    <div class="settings-help">
                        <h3>How to get an API key</h3>
                        <ol>
                            <li>Open <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer">OpenAI API keys</a> and sign in.</li>
                            <li>Create a new secret key for this app.</li>
                            <li>Copy it immediately. OpenAI only shows the full key once.</li>
                            <li>Paste it here, save, then test the connection.</li>
                        </ol>
                        <p>Keep the key private. If it is lost or exposed, delete it in OpenAI and create a new one.</p>
                    </div>
                </div>

                <div class="settings-options-grid">
                    <div class="settings-field">
                        <label for="ai-model">Model</label>
                        <div class="settings-input-wrap">
                            <span class="material-symbols-outlined" aria-hidden="true">memory</span>
                            <select id="ai-model" class="settings-input mono select" @bind="model">
                                <option value="gpt-5.6-luna">gpt-5.6-luna</option>
                                <option value="gpt-4o">gpt-4o</option>
                                <option value="gpt-4-turbo">gpt-4-turbo</option>
                                <option value="gpt-3.5-turbo">gpt-3.5-turbo</option>
                            </select>
                            <span class="material-symbols-outlined settings-select-icon" aria-hidden="true">expand_more</span>
                        </div>
                        <p>Model used for transaction categorization.</p>
                    </div>

                    <div class="settings-field">
                        <label for="request-timeout">Request Timeout</label>
                        <div class="settings-input-wrap">
                            <span class="material-symbols-outlined" aria-hidden="true">timer</span>
                            <input id="request-timeout"
                                   class="settings-input mono"
                                   type="number"
                                   min="5"
                                   max="180"
                                   step="1"
                                   @bind="requestTimeoutSeconds" />
                        </div>
                        <p>Seconds before categorization falls back to review.</p>
                    </div>
                </div>

                <div class="settings-test-section">
                    <div>
                        <h3>Test Connection</h3>
                        <p>Verify your API credentials and latency.</p>
                    </div>
                    <div class="settings-action-buttons">
                        <button type="button" class="primary-button" @onclick="SaveAsync" disabled="@isBusy">
                            Save
                        </button>
                        <button type="button" class="secondary-button" @onclick="TestConnectionAsync" disabled="@isBusy">
                            Test Connection
                        </button>
                        <button type="button" class="danger-button" @onclick="DeleteConfigurationAsync" disabled="@(isBusy || !CanDeleteConfiguration)">
                            Delete Configuration
                        </button>
                    </div>
                </div>

                <SettingsStatus Message="@statusMessage" Kind="@statusKind" />
                </div>
            </ChildContent>
        </Card>
        }
        else if (activeTab == SettingsTab.Data)
        {
            <SettingsDataPanel StorageLocation="@StorageLocation"
                               IsBusy="@isBusy"
                               StatusMessage="@statusMessage"
                               StatusKind="@statusKind"
                               OnDeleteLocalData="DeleteLocalDataAsync" />
        }
        else if (activeTab == SettingsTab.DevTesting)
        {
            <SettingsDeveloperTestingPanel LogsFolderLocation="@LogsFolderLocation"
                                           IsBusy="@isBusy"
                                           StatusMessage="@statusMessage"
                                           StatusKind="@statusKind"
                                           OnOpenLogsFolder="OpenLogsFolder" />
        }
    </div>
</section>

@code {
    private SettingsTab activeTab = SettingsTab.Ai;
    private string apiKey = string.Empty;
    private string model = string.Empty;
    private int requestTimeoutSeconds;
    private bool hasConfiguredApiKey;
    private bool showApiKey;
    private bool isBusy;
    private string? statusMessage;
    private SettingsStatusKind statusKind;

    private const string DefaultModel = "gpt-5.6-luna";

    private const int DefaultRequestTimeoutSeconds = 25;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private string StorageLocation => SpendnestDataPaths.GetDefaultDatabasePath();

    private string LogsFolderLocation =>
        Path.GetDirectoryName(SpendnestDataPaths.GetDefaultLogPath())
        ?? SpendnestDataPaths.GetDefaultLogPath();

    private bool CanDeleteConfiguration =>
        hasConfiguredApiKey || !string.IsNullOrWhiteSpace(apiKey);

    private string ApiKeyInputType => showApiKey ? "text" : "password";

    private string ApiKeyVisibilityIcon => showApiKey ? "visibility_off" : "visibility";

    private string ApiKeyVisibilityLabel => showApiKey ? "Hide API key" : "Show API key";

    private string ApiKeyPlaceholder => hasConfiguredApiKey ? "Saved key is configured" : "sk-...";

    private string ApiKeyHelpText => hasConfiguredApiKey
        ? "Leave blank to keep the saved key, or enter a new one to replace it."
        : "The key is stored in platform secure storage on this device.";

    protected override async Task OnInitializedAsync()
    {
        var storedApiKey = await CredentialStore.GetStringAsync(CredentialKeys.OpenAiApiKey, CancellationToken.None);
        hasConfiguredApiKey = !string.IsNullOrWhiteSpace(storedApiKey);
        model = OpenAiOptions.Model;
        requestTimeoutSeconds = Math.Max(1, (int)Math.Round(OpenAiOptions.RequestTimeout.TotalSeconds));
    }

    protected override void OnParametersSet()
    {
        activeTab = RequestedTab?.ToLowerInvariant() switch
        {
            "data" => SettingsTab.Data,
            "dev-testing" => SettingsTab.DevTesting,
            _ => SettingsTab.Ai
        };
    }

    private void SelectTab(SettingsTab tab)
    {
        activeTab = tab;
        statusMessage = null;
        NavigationManager.NavigateTo(tab switch
        {
            SettingsTab.Data => "settings?tab=data",
            SettingsTab.DevTesting => "settings?tab=dev-testing",
            _ => "settings"
        });
    }

    private void ToggleApiKeyVisibility()
    {
        showApiKey = !showApiKey;
    }

    private async Task TestConnectionAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var hasKey = !string.IsNullOrWhiteSpace(apiKey) || hasConfiguredApiKey;
            if (!hasKey)
            {
                SetStatus("Enter an API key before testing.", SettingsStatusKind.Error);
                return;
            }

            if (!IsValidModel(model))
            {
                SetStatus("Choose a ChatGPT model.", SettingsStatusKind.Error);
                return;
            }

            var result = await AiConnectionTestService.TestOpenAiAsync(
                new AiConnectionTestRequest(
                    apiKey,
                    model,
                    TimeSpan.FromSeconds(requestTimeoutSeconds)),
                CancellationToken.None);
            SetStatus(result.Message, result.Succeeded ? SettingsStatusKind.Success : SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            if (!IsValidModel(model))
            {
                SetStatus("Choose a ChatGPT model.", SettingsStatusKind.Error);
                return;
            }

            if (requestTimeoutSeconds is < 5 or > 180)
            {
                SetStatus("Timeout must be between 5 and 180 seconds.", SettingsStatusKind.Error);
                return;
            }

            if (!string.IsNullOrWhiteSpace(apiKey))
            {
                await CredentialStore.SaveStringAsync(CredentialKeys.OpenAiApiKey, apiKey, CancellationToken.None);
                apiKey = string.Empty;
                hasConfiguredApiKey = true;
            }
            else if (!hasConfiguredApiKey)
            {
                SetStatus("API key is required.", SettingsStatusKind.Error);
                return;
            }

            OpenAiOptions.Model = model;
            OpenAiOptions.RequestTimeout = TimeSpan.FromSeconds(requestTimeoutSeconds);
            SetStatus("AI configuration saved.", SettingsStatusKind.Success);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not save configuration: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteConfigurationAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            await CredentialStore.ClearAsync(CredentialKeys.OpenAiApiKey, CancellationToken.None);
            apiKey = string.Empty;
            hasConfiguredApiKey = false;
            showApiKey = false;
            model = DefaultModel;
            requestTimeoutSeconds = DefaultRequestTimeoutSeconds;
            OpenAiOptions.Model = model;
            OpenAiOptions.RequestTimeout = TimeSpan.FromSeconds(requestTimeoutSeconds);
            SetStatus("AI connection details deleted.", SettingsStatusKind.Success);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not delete AI connection details: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteLocalDataAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            await DatabaseInitializer.DeleteUserDataAsync(CancellationToken.None);
            SetStatus("Local data deleted.", SettingsStatusKind.Success);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not delete local data: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OpenLogsFolder()
    {
        statusMessage = null;
        try
        {
            Directory.CreateDirectory(LogsFolderLocation);
            Process.Start(new ProcessStartInfo
            {
                FileName = LogsFolderLocation,
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            SetStatus($"Could not open logs folder: {ex.Message}", SettingsStatusKind.Error);
        }
    }

    private void SetStatus(string message, SettingsStatusKind kind)
    {
        statusMessage = message;
        statusKind = kind;
    }

    private static bool IsValidModel(string value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.StartsWith("gpt-", StringComparison.OrdinalIgnoreCase);
    }

}
