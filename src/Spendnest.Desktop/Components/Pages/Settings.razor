@page "/settings"
@inject SettingsPageService SettingsPageService
@inject NavigationManager NavigationManager

<PageTitle>Settings - PeasantMoney</PageTitle>

<section class="settings-header">
    <div>
        <h1>Settings</h1>
        <p>Manage PeasantMoney workspace preferences and integrations.</p>
    </div>
</section>

<section class="settings-layout">
    <SettingsSubnav ActiveTab="@activeTab" OnTabSelected="SelectTab" />

    <div class="settings-content">
        @if (activeTab == SettingsTab.Ai)
        {
            <Card Class="settings-card"
                  Title="AI Configuration"
                  Subtitle="Configure your language model provider for smart transaction categorization.">
                <HeaderAction>
                    <SettingsConnectionStatus IsConnected="@hasConfiguredApiKey" />
                </HeaderAction>

                <ChildContent>
                    <SettingsAiConfigurationPanel State="@AiConfigurationState"
                                                  ApiKeyChanged="OnApiKeyChanged"
                                                  ModelChanged="OnModelChanged"
                                                  RequestTimeoutSecondsChanged="OnRequestTimeoutSecondsChanged"
                                                  OnToggleApiKeyVisibility="ToggleApiKeyVisibility"
                                                  OnSave="SaveAsync"
                                                  OnTestConnection="TestConnectionAsync"
                                                  OnDeleteConfiguration="DeleteConfigurationAsync" />
                </ChildContent>
            </Card>
        }
        else if (activeTab == SettingsTab.Data)
        {
            <Card Class="settings-card"
                  Title="Data & Privacy"
                  Subtitle="Manage your local database, backups, and privacy controls.">
                <SettingsDataPanel StorageLocation="@StorageLocation"
                                   IsBusy="@isBusy"
                                   StatusMessage="@statusMessage"
                                   StatusKind="@statusKind"
                                   OnDeleteLocalData="DeleteLocalDataAsync" />
            </Card>
        }
        else if (activeTab == SettingsTab.DevTesting)
        {
            <Card Class="settings-card"
                  Title="Developer Testing"
                  Subtitle="Locate diagnostic files used while testing packaged and local builds.">
                <SettingsDeveloperTestingPanel LogsFolderLocation="@LogsFolderLocation"
                                               IsBusy="@isBusy"
                                               StatusMessage="@statusMessage"
                                               StatusKind="@statusKind"
                                               OnOpenLogsFolder="OpenLogsFolder" />
            </Card>
        }
    </div>
</section>

@code {
    private SettingsTab activeTab = SettingsTab.Ai;
    private string apiKey = string.Empty;
    private string model = string.Empty;
    private int requestTimeoutSeconds;
    private bool hasConfiguredApiKey;
    private bool showApiKey;
    private bool isBusy;
    private string? statusMessage;
    private SettingsStatusKind statusKind;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private string StorageLocation => SettingsPageService.StorageLocation;

    private string LogsFolderLocation => SettingsPageService.LogsFolderLocation;

    private SettingsAiConfigurationState AiConfigurationState => new(
        apiKey,
        model,
        requestTimeoutSeconds,
        hasConfiguredApiKey,
        showApiKey,
        isBusy,
        statusMessage,
        statusKind);

    protected override async Task OnInitializedAsync()
    {
        var pageData = await SettingsPageService.LoadAsync(CancellationToken.None);
        hasConfiguredApiKey = pageData.HasConfiguredApiKey;
        model = pageData.Model;
        requestTimeoutSeconds = pageData.RequestTimeoutSeconds;
    }

    protected override void OnParametersSet()
    {
        activeTab = RequestedTab?.ToLowerInvariant() switch
        {
            "data" => SettingsTab.Data,
            "dev-testing" => SettingsTab.DevTesting,
            _ => SettingsTab.Ai
        };
    }

    private void SelectTab(SettingsTab tab)
    {
        activeTab = tab;
        statusMessage = null;
        NavigationManager.NavigateTo(tab switch
        {
            SettingsTab.Data => "settings?tab=data",
            SettingsTab.DevTesting => "settings?tab=dev-testing",
            _ => "settings"
        });
    }

    private void ToggleApiKeyVisibility()
    {
        showApiKey = !showApiKey;
    }

    private void OnApiKeyChanged(string value)
    {
        apiKey = value;
    }

    private void OnModelChanged(string value)
    {
        model = value;
    }

    private void OnRequestTimeoutSecondsChanged(int value)
    {
        requestTimeoutSeconds = value;
    }

    private async Task TestConnectionAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await SettingsPageService.TestConnectionAsync(
                apiKey,
                hasConfiguredApiKey,
                model,
                requestTimeoutSeconds,
                CancellationToken.None);
            SetStatus(result);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await SettingsPageService.SaveAiConfigurationAsync(
                apiKey,
                hasConfiguredApiKey,
                model,
                requestTimeoutSeconds,
                CancellationToken.None);
            SetStatus(result);

            if (result.StatusKind == SettingsStatusKind.Success)
            {
                apiKey = string.Empty;
                hasConfiguredApiKey = true;
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Could not save configuration: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteConfigurationAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await SettingsPageService.DeleteConfigurationAsync(CancellationToken.None);
            if (result.StatusKind == SettingsStatusKind.Success)
            {
                var pageData = await SettingsPageService.LoadAsync(CancellationToken.None);
                apiKey = string.Empty;
                hasConfiguredApiKey = pageData.HasConfiguredApiKey;
                showApiKey = false;
                model = pageData.Model;
                requestTimeoutSeconds = pageData.RequestTimeoutSeconds;
            }

            SetStatus(result);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not delete AI connection details: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteLocalDataAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await SettingsPageService.DeleteLocalDataAsync(CancellationToken.None);
            SetStatus(result);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not delete local data: {ex.Message}", SettingsStatusKind.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OpenLogsFolder()
    {
        statusMessage = null;
        try
        {
            SettingsPageService.OpenLogsFolder();
        }
        catch (Exception ex)
        {
            SetStatus($"Could not open logs folder: {ex.Message}", SettingsStatusKind.Error);
        }
    }

    private void SetStatus(string message, SettingsStatusKind kind)
    {
        statusMessage = message;
        statusKind = kind;
    }

    private void SetStatus(SettingsOperationResult result)
    {
        SetStatus(result.Message, result.StatusKind);
    }

}
