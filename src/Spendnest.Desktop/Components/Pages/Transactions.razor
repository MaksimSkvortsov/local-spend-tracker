@page "/transactions"
@inject TransactionsPageService TransactionsPageService
@inject AppDataRefreshNotifier DataRefreshNotifier

<PageTitle>Transactions - PeasantMoney</PageTitle>

<section class="transactions-page-header">
    <div>
        <h1>Transactions</h1>
        <p>Review and manage your financial activity.</p>
    </div>
</section>

<section class="transactions-surface">
    <div class="app-card transaction-table-card">
        <TransactionsToolbar ReviewFilterMode="@reviewFilterMode"
                             OnReviewFilterChanged="SetReviewFilter"
                             ReviewCount="@reviewCount"
                             TransactionCount="@FilteredTransactions.Count"
                             Categories="@categories"
                             SelectedCategoryId="@selectedCategoryId"
                             SelectedCategoryIdChanged="SetSelectedCategory"
                             Cards="@cards"
                             SelectedCardId="@selectedCardId"
                             SelectedCardIdChanged="SetSelectedCard" />

        @if (!string.IsNullOrWhiteSpace(categorySaveError))
        {
            <div class="transactions-alert-wrap">
                <div class="alert error">@categorySaveError</div>
            </div>
        }

        @if (transactions.Count == 0)
        {
            <div class="empty-state">No transactions imported yet.</div>
        }
        else if (FilteredTransactions.Count == 0)
        {
            <div class="empty-state">No transactions match these filters.</div>
        }
        else
        {
            <TransactionsTable Transactions="@PagedTransactions"
                               TotalCount="@FilteredTransactions.Count"
                               Categories="@categories"
                               SavingCategoryTransactionId="@savingCategoryTransactionId"
                               CurrentPage="@currentPage"
                               PageCount="@PageCount"
                               OnCategoryChanged="ChangeCategoryAsync"
                               OnPrevious="PreviousPage"
                               OnNext="NextPage" />
        }
    </div>

    <div class="transaction-bottom-spacer" aria-hidden="true"></div>
</section>

@code {
    private const int PageSize = 10;

    private IReadOnlyList<Transaction> transactions = [];
    private IReadOnlyList<CardAccount> cards = [];
    private IReadOnlyList<BuiltInCategory> categories = [];
    private string selectedCardId = string.Empty;
    private string selectedCategoryId = string.Empty;
    private ReviewFilterMode reviewFilterMode = ReviewFilterMode.All;
    private int reviewCount;
    private int currentPage = 1;
    private Guid? savingCategoryTransactionId;
    private string? categorySaveError;
    private IReadOnlyDictionary<Guid, TransactionCategoryAssignment> assignmentsByTransactionId =
        new Dictionary<Guid, TransactionCategoryAssignment>();
    private IReadOnlyDictionary<int, string> categoryColorsById =
        new Dictionary<int, string>();
    private IReadOnlyDictionary<Guid, string> cardNamesById =
        new Dictionary<Guid, string>();

    private IReadOnlyList<Transaction> FilteredTransactions =>
        transactions
            .Where(MatchesSelectedCard)
            .Where(MatchesSelectedCategory)
            .Where(MatchesReviewFilter)
            .ToArray();

    private PagedList<Transaction> TransactionPage =>
        PagedList<Transaction>.Create(FilteredTransactions, currentPage, PageSize);

    private IReadOnlyList<TransactionRow> PagedTransactions =>
        TransactionRows.FromTransactions(
            TransactionPage.Items,
            assignmentsByTransactionId,
            categoryColorsById,
            cardNamesById);

    private int PageCount => TransactionPage.PageCount;

    protected override async Task OnInitializedAsync()
    {
        var pageData = await TransactionsPageService.LoadAsync(CancellationToken.None);

        transactions = pageData.Transactions;
        cards = pageData.Cards;
        categories = pageData.Categories;
        assignmentsByTransactionId = pageData.AssignmentsByTransactionId;
        categoryColorsById = pageData.CategoryColorsById;
        cardNamesById = pageData.CardNamesById;
        reviewCount = pageData.ReviewCount;
    }

    private int GetCategoryId(Transaction transaction)
    {
        return assignmentsByTransactionId.TryGetValue(transaction.Id, out var assignment)
            ? assignment.CategoryId
            : BuiltInCategoryIds.Other;
    }

    private bool MatchesSelectedCard(Transaction transaction)
    {
        if (string.IsNullOrWhiteSpace(selectedCardId))
        {
            return true;
        }

        return Guid.TryParse(selectedCardId, out var cardId) && transaction.CardAccountId == cardId;
    }

    private bool MatchesSelectedCategory(Transaction transaction)
    {
        if (string.IsNullOrWhiteSpace(selectedCategoryId))
        {
            return true;
        }

        return int.TryParse(selectedCategoryId, out var categoryId) && GetCategoryId(transaction) == categoryId;
    }

    private bool MatchesReviewFilter(Transaction transaction)
    {
        return reviewFilterMode == ReviewFilterMode.All || NeedsReview(transaction);
    }

    private bool NeedsReview(Transaction transaction)
    {
        return assignmentsByTransactionId.TryGetValue(transaction.Id, out var assignment) && assignment.NeedsReview;
    }

    private void SetReviewFilter(ReviewFilterMode mode)
    {
        reviewFilterMode = mode;
        ResetPagination();
    }

    private void SetSelectedCategory(string categoryId)
    {
        selectedCategoryId = categoryId;
        ResetPagination();
    }

    private void SetSelectedCard(string cardId)
    {
        selectedCardId = cardId;
        ResetPagination();
    }

    private async Task ChangeCategoryAsync(TransactionCategoryChange change)
    {
        categorySaveError = null;
        if (!int.TryParse(change.CategoryId, out var categoryId) || categoryId == change.CurrentCategoryId)
        {
            return;
        }

        savingCategoryTransactionId = change.TransactionId;
        try
        {
            await TransactionsPageService.SetCategoryAsync(
                change.TransactionId,
                categoryId,
                CancellationToken.None);
            await ReloadAssignmentsAsync();
            DataRefreshNotifier.NotifyTransactionsChanged();
            ResetPaginationAfterCategoryChange();
        }
        catch (Exception ex)
        {
            categorySaveError = $"Could not update category: {ex.Message}";
        }
        finally
        {
            savingCategoryTransactionId = null;
        }
    }

    private async Task ReloadAssignmentsAsync()
    {
        var reviewState = await TransactionsPageService.LoadReviewStateAsync(CancellationToken.None);

        assignmentsByTransactionId = reviewState.AssignmentsByTransactionId;
        reviewCount = reviewState.ReviewCount;
    }

    private void ResetPaginationAfterCategoryChange()
    {
        currentPage = Math.Min(currentPage, PageCount);
    }

    private void ResetPagination()
    {
        currentPage = 1;
    }

    private void PreviousPage()
    {
        currentPage = Math.Max(1, currentPage - 1);
    }

    private void NextPage()
    {
        currentPage = Math.Min(PageCount, currentPage + 1);
    }

}
