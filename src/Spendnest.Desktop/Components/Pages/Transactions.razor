@page "/transactions"
@inject TransactionsPageService TransactionsPageService
@inject AppDataRefreshNotifier DataRefreshNotifier

<PageTitle>Transactions - PeasantMoney</PageTitle>

<div class="transactions-page">
    <section class="transactions-page-header">
        <div>
            <h1>Transactions</h1>
            <p>Review and manage your financial activity.</p>
        </div>
    </section>

    <section class="transactions-surface">
        <Card Class="transaction-table-card">
            <TransactionsToolbar ReviewFilterMode="@reviewFilterMode"
                                 OnReviewFilterChanged="SetReviewFilter"
                                 ReviewCount="@reviewCount"
                                 TransactionCount="@FilteredTransactions.Count"
                                 Categories="@categories"
                                 SelectedCategoryId="@selectedCategoryId"
                                 SelectedCategoryIdChanged="SetSelectedCategory"
                                 Cards="@cards"
                                 SelectedCardId="@selectedCardId"
                                 SelectedCardIdChanged="SetSelectedCard" />

            @if (!string.IsNullOrWhiteSpace(categorySaveError))
            {
                <div class="transactions-alert-wrap">
                    <div class="alert error">@categorySaveError</div>
                </div>
            }

            @if (transactions.Count == 0)
            {
                <div class="empty-state">No transactions imported yet.</div>
            }
            else if (FilteredTransactions.Count == 0)
            {
                <div class="empty-state">No transactions match these filters.</div>
            }
            else
            {
                <TransactionsTable Transactions="@PagedTransactions"
                                   TotalCount="@FilteredTransactions.Count"
                                   Categories="@categories"
                                   SavingCategoryTransactionId="@savingCategoryTransactionId"
                                   CurrentPage="@currentPage"
                                   PageCount="@PageCount"
                                   OnCategoryChanged="ChangeCategoryAsync"
                                   OnPrevious="PreviousPage"
                                   OnNext="NextPage" />
            }
        </Card>
    </section>
</div>

@code {
    private const int PageSize = 10;

    private IReadOnlyList<TransactionRow> transactions = [];
    private IReadOnlyList<CardAccount> cards = [];
    private IReadOnlyList<BuiltInCategory> categories = [];
    private string selectedCardId = string.Empty;
    private string selectedCategoryId = string.Empty;
    private ReviewFilterMode reviewFilterMode = ReviewFilterMode.All;
    private int reviewCount;
    private int currentPage = 1;
    private Guid? savingCategoryTransactionId;
    private string? categorySaveError;

    private TransactionFilter CurrentFilter =>
        new(selectedCardId, selectedCategoryId, reviewFilterMode);

    private IReadOnlyList<TransactionRow> FilteredTransactions =>
        TransactionFilters.Apply(transactions, CurrentFilter);

    private PagedList<TransactionRow> TransactionPage =>
        PagedList<TransactionRow>.Create(FilteredTransactions, currentPage, PageSize);

    private IReadOnlyList<TransactionRow> PagedTransactions => TransactionPage.Items;

    private int PageCount => TransactionPage.PageCount;

    protected override async Task OnInitializedAsync()
    {
        var pageData = await TransactionsPageService.LoadAsync(CancellationToken.None);

        transactions = pageData.Transactions;
        cards = pageData.Cards;
        categories = pageData.Categories;
        reviewCount = pageData.ReviewCount;
    }

    private void SetReviewFilter(ReviewFilterMode mode)
    {
        reviewFilterMode = mode;
        ResetPagination();
    }

    private void SetSelectedCategory(string categoryId)
    {
        selectedCategoryId = categoryId;
        ResetPagination();
    }

    private void SetSelectedCard(string cardId)
    {
        selectedCardId = cardId;
        ResetPagination();
    }

    private async Task ChangeCategoryAsync(TransactionCategoryChange change)
    {
        categorySaveError = null;
        if (!int.TryParse(change.CategoryId, out var categoryId) || categoryId == change.CurrentCategoryId)
        {
            return;
        }

        savingCategoryTransactionId = change.TransactionId;
        try
        {
            await TransactionsPageService.SetCategoryAsync(
                change.TransactionId,
                categoryId,
                CancellationToken.None);
            await ReloadPageDataAsync();
            DataRefreshNotifier.NotifyTransactionsChanged();
            ResetPaginationAfterCategoryChange();
        }
        catch (Exception ex)
        {
            categorySaveError = $"Could not update category: {ex.Message}";
        }
        finally
        {
            savingCategoryTransactionId = null;
        }
    }

    private async Task ReloadPageDataAsync()
    {
        var pageData = await TransactionsPageService.LoadAsync(CancellationToken.None);

        transactions = pageData.Transactions;
        cards = pageData.Cards;
        categories = pageData.Categories;
        reviewCount = pageData.ReviewCount;
    }

    private void ResetPaginationAfterCategoryChange()
    {
        currentPage = Math.Min(currentPage, PageCount);
    }

    private void ResetPagination()
    {
        currentPage = 1;
    }

    private void PreviousPage()
    {
        currentPage = Math.Max(1, currentPage - 1);
    }

    private void NextPage()
    {
        currentPage = Math.Min(PageCount, currentPage + 1);
    }

}
