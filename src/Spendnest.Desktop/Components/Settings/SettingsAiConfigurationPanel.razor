<div class="settings-form">
    <div class="settings-field">
        <label>Provider</label>
        <div class="provider-display" aria-label="AI provider">
            <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
            ChatGPT
        </div>
        <p>Only OpenAI is supported for now.</p>
    </div>

    <div class="settings-key-section">
        <div class="settings-field">
            <label for="api-key">OpenAI API Key <span>*</span></label>
            <div class="settings-key-row">
                <div class="settings-input-wrap">
                    <span class="material-symbols-outlined" aria-hidden="true">key</span>
                    <input id="api-key"
                           class="settings-input mono"
                           type="@ApiKeyInputType"
                           placeholder="@ApiKeyPlaceholder"
                           value="@ApiKey"
                           @onchange="HandleApiKeyChanged" />
                    <button type="button" class="settings-field-button" aria-label="@ApiKeyVisibilityLabel" @onclick="OnToggleApiKeyVisibility">
                        <span class="material-symbols-outlined" aria-hidden="true">@ApiKeyVisibilityIcon</span>
                    </button>
                </div>
            </div>
            <div class="settings-note">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>@ApiKeyHelpText Usage is billed directly by OpenAI.</p>
            </div>
        </div>

        <div class="settings-help">
            <h3>How to get an API key</h3>
            <ol>
                <li>Open <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer">OpenAI API keys</a> and sign in.</li>
                <li>Create a new secret key for this app.</li>
                <li>Copy it immediately. OpenAI only shows the full key once.</li>
                <li>Paste it here, save, then test the connection.</li>
            </ol>
            <p>Keep the key private. If it is lost or exposed, delete it in OpenAI and create a new one.</p>
        </div>
    </div>

    <div class="settings-options-grid">
        <div class="settings-field">
            <label for="ai-model">Model</label>
            <div class="settings-input-wrap">
                <span class="material-symbols-outlined" aria-hidden="true">memory</span>
                <select id="ai-model" class="settings-input mono select" value="@Model" @onchange="HandleModelChanged">
                    <option value="gpt-5.6-luna">gpt-5.6-luna</option>
                    <option value="gpt-4o">gpt-4o</option>
                    <option value="gpt-4-turbo">gpt-4-turbo</option>
                    <option value="gpt-3.5-turbo">gpt-3.5-turbo</option>
                </select>
                <span class="material-symbols-outlined settings-select-icon" aria-hidden="true">expand_more</span>
            </div>
            <p>Model used for transaction categorization.</p>
        </div>

        <div class="settings-field">
            <label for="request-timeout">Request Timeout</label>
            <div class="settings-input-wrap">
                <span class="material-symbols-outlined" aria-hidden="true">timer</span>
                <input id="request-timeout"
                       class="settings-input mono"
                       type="number"
                       min="5"
                       max="180"
                       step="1"
                       value="@RequestTimeoutSeconds"
                       @onchange="HandleRequestTimeoutChanged" />
            </div>
            <p>Seconds before categorization falls back to review.</p>
        </div>
    </div>

    <div class="settings-test-section">
        <div>
            <h3>Test Connection</h3>
            <p>Verify your API credentials and latency.</p>
        </div>
        <div class="settings-action-buttons">
            <button type="button" class="primary-button" @onclick="OnSave" disabled="@IsBusy">
                Save
            </button>
            <button type="button" class="secondary-button" @onclick="OnTestConnection" disabled="@IsBusy">
                Test Connection
            </button>
            <button type="button" class="danger-button" @onclick="OnDeleteConfiguration" disabled="@(IsBusy || !CanDeleteConfiguration)">
                Delete Configuration
            </button>
        </div>
    </div>

    <SettingsStatus Message="@StatusMessage" Kind="@StatusKind" />
</div>

@code {
    [Parameter]
    public string ApiKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ApiKeyChanged { get; set; }

    [Parameter]
    public string Model { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ModelChanged { get; set; }

    [Parameter]
    public int RequestTimeoutSeconds { get; set; }

    [Parameter]
    public EventCallback<int> RequestTimeoutSecondsChanged { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool CanDeleteConfiguration { get; set; }

    [Parameter]
    public string ApiKeyInputType { get; set; } = "password";

    [Parameter]
    public string ApiKeyVisibilityIcon { get; set; } = "visibility";

    [Parameter]
    public string ApiKeyVisibilityLabel { get; set; } = "Show API key";

    [Parameter]
    public string ApiKeyPlaceholder { get; set; } = "sk-...";

    [Parameter]
    public string ApiKeyHelpText { get; set; } = string.Empty;

    [Parameter]
    public string? StatusMessage { get; set; }

    [Parameter]
    public SettingsStatusKind StatusKind { get; set; }

    [Parameter]
    public EventCallback OnToggleApiKeyVisibility { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnTestConnection { get; set; }

    [Parameter]
    public EventCallback OnDeleteConfiguration { get; set; }

    private Task HandleApiKeyChanged(ChangeEventArgs args)
    {
        return ApiKeyChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleModelChanged(ChangeEventArgs args)
    {
        return ModelChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleRequestTimeoutChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            return RequestTimeoutSecondsChanged.InvokeAsync(value);
        }

        return Task.CompletedTask;
    }
}
