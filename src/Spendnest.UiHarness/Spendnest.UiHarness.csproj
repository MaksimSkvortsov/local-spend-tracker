<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spendnest.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spendnest.Application\Spendnest.Application.csproj" />
    <ProjectReference Include="..\Spendnest.Core\Spendnest.Core.csproj" />
    <ProjectReference Include="..\Spendnest.Infrastructure\Spendnest.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Spendnest.Desktop\Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Spendnest.Desktop\Components\**\*.razor.css" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Spendnest.Desktop\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Spendnest.Desktop\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Spendnest.Desktop\State\**\*.cs" Link="State\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Spendnest.Desktop\Presentation\**\*.cs" Link="Presentation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Spendnest.Desktop\Components\Layout\**\*.cs" Link="Components\Layout\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
